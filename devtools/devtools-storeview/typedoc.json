{
  "$schema": "https://typedoc.org/schema.json",
  "name": "@yoltra/devtools-storeview",
  "entryPoints": ["src/index.tsx"],
  "tsconfig": "./tsconfig.docs.json",
  // Pinned rather than derived. TypeDoc builds "Defined in" links from the local git remote, so
  // generating from a clone that does not point at GitHub would emit plain text instead of links.
  // {gitRevision} is the commit being documented, so a reference generated from a release tag
  // links to the source as it was released, not to whatever `main` holds later.
  "sourceLinkTemplate": "https://github.com/yoltra/yoltra/blob/{gitRevision}/{path}#L{line}",
  // TypeDoc cannot follow a {@link} across package boundaries on its own, so a cross-package
  // reference would render as dead text. These map the few symbols this package names to their
  // pages in the API reference on yoltra.dev.
  "externalSymbolLinkMappings": {
    "@yoltra/devtools-ui": {
      "HubProvider": "https://yoltra.dev/en/yoltra/api/devtools-ui/HubProvider/"
    }
  },
  "entryPointStrategy": "resolve",
  "readme": "none",
  "logLevel": "Verbose",
  "categorizeByGroup": true,
  // Inherited DOM props are not this package's API, and documenting them would drag the resolved
  // path of `@types/react` (pnpm store hash, version and all) into the reference, where a
  // dependency bump would change every page that extends an element.
  "excludeExternals": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeProtected": true
}

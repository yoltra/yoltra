{
  "name": "@yoltra/devtools-cli",
  "version": "0.4.0",
  "description": "Yoltra DevTools terminal UI (React + Ink)",
  "author": {
    "name": "Manu Ramirez <@pixerael>",
    "email": "manu@yoltra.dev"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yoltra/yoltra.git"
  },
  "type": "module",
  "main": "dist/devtools-cli.mjs",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/devtools-cli.mjs"
    }
  },
  "bin": {
    "yoltra-devtools": "./bin/devtools-cli.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "vite build && node ../../tools/repo-tools/bin/dts-extensions.mjs dist/types",
    "test": "vitest --watch=false",
    "lint": "node ../../tools/repo-tools/bin/repo-eslint.cjs --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.vitest.json --noEmit",
    "docs": "rushx docs:js && rushx docs:md && rushx docs:stamp",
    "docs:stamp": "node ../../tools/repo-tools/bin/docs-stamp.mjs docs",
    "docs:md": "typedoc --options ./typedoc.json",
    "docs:js": "typedoc --options ./typedoc.json --json ./.typedoc/devtools-cli-en.json"
  },
  "dependencies": {
    "@yoltra/devtools-protocol": "workspace:*",
    "@yoltra/devtools-server": "workspace:*",
    "@yoltra/devtools-ui": "workspace:*",
    "ink": "^6.8.0",
    "ink-text-input": "^6.0.0",
    "react": "19.1.1",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.12",
    "@types/react": "^19.1.8",
    "@types/ws": "^8.18.1",
    "ink-testing-library": "4.0.0",
    "typedoc": "^0.28.13",
    "typedoc-plugin-localization": "3.0.6",
    "typedoc-plugin-markdown": "4.9.0",
    "typescript": "5.9.3",
    "vite": "^7.1.11",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=18.18"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@yoltra/core",
  "version": "0.4.0",
  "description": "A modern predictable state container built on the idea of channels, events, and payloads, giving you strongly typed, expressive actions",
  "scripts": {
    "dev": "vite",
    "lint": "node ../../tools/repo-tools/bin/repo-eslint.cjs --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "node ../../tools/repo-tools/bin/repo-eslint.cjs --fix",
    "test": "vitest --coverage --watch=false",
    "build": "vite build && node ../../tools/repo-tools/bin/dts-extensions.mjs dist/types",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.vitest.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "typecheck:tools": "tsc -p tsconfig.tools.json --noEmit",
    "preview": "vite preview",
    "prepublishOnly": "node ../../common/scripts/copy-license.cjs",
    "docs": "rushx docs:js && rushx docs:md && rushx docs:stamp",
    "docs:stamp": "node ../../tools/repo-tools/bin/docs-stamp.mjs docs",
    "docs:md": "typedoc --options ./typedoc.core.json",
    "docs:js": "typedoc --options ./typedoc.core.json --json ./.typedoc/core-en.json",
    "size": "node ../../tools/repo-tools/bin/size-check.cjs",
    "bench": "vitest bench --run",
    "bench:check": "node ../../tools/repo-tools/bin/bench-check.cjs",
    "bench:record": "node ../../tools/repo-tools/bin/bench-check.cjs --record"
  },
  "license": "MIT",
  "author": {
    "name": "Manu Ramirez <@pixerael>",
    "email": "manu@yoltra.dev"
  },
  "maintainers": [],
  "homepage": "https://yoltra.dev",
  "keywords": [
    "state",
    "store",
    "react",
    "redux-alternative",
    "yoltra"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yoltra/yoltra.git"
  },
  "bugs": {
    "url": "https://github.com/yoltra/yoltra/issues"
  },
  "main": "dist/yoltra.cjs",
  "module": "dist/yoltra.mjs",
  "types": "dist/types/index.d.ts",
  "unpkg": "dist/yoltra.umd.js",
  "jsdelivr": "dist/yoltra.umd.js",
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "private": false,
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.18"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/yoltra.mjs",
      "require": "./dist/yoltra.cjs",
      "default": "./dist/yoltra.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.12",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "^3.2.4",
    "typedoc": "^0.28.13",
    "typedoc-plugin-markdown": "4.9.0",
    "typedoc-plugin-localization": "3.0.6",
    "typescript": "5.9.3",
    "vite": "^7.1.11",
    "vite-plugin-banner": "0.8.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "3.2.4"
  },
  "sizeLimit": [
    {
      "name": "createStore",
      "import": "{ createStore }",
      "limitKb": 8
    },
    {
      "name": "with persistence",
      "import": "{ createStore, hydrate, persist }",
      "limitKb": 10
    },
    {
      "name": "barrel",
      "limitKb": 11
    }
  ]
}

{
  "$schema": "https://typedoc.org/schema.json",
  "name": "@yoltra/core",
  "entryPoints": [
    "src/index.ts"
  ],
  
  "tsconfig": "./tsconfig.json",
  // Pinned rather than derived. TypeDoc builds "Defined in" links from the local git remote, so
  // generating from a clone that does not point at GitHub would emit plain text instead of links.
  // {gitRevision} is the commit being documented, so a reference generated from a release tag
  // links to the source as it was released, not to whatever `main` holds later.
  "sourceLinkTemplate": "https://github.com/yoltra/yoltra/blob/{gitRevision}/{path}#L{line}",
  "entryPointStrategy": "resolve",
  "readme": "none",
  "logLevel": "Verbose",

  "categorizeByGroup": true,
  "excludeExternals": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeProtected": true,
  "includeVersion": false,
}
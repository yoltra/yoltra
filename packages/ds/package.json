{
  "name": "@yoltra/ds",
  "version": "0.2.0",
  "description": "Yoltra Design System \u2014 tokens and primitive React components shared across the website, docs, and examples",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build && node scripts/build-styles.mjs && node ../../tools/repo-tools/bin/dts-extensions.mjs dist/types",
    "lint": "node ../../tools/repo-tools/bin/repo-eslint.cjs --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "node ../../tools/repo-tools/bin/repo-eslint.cjs --fix",
    "docs": "typedoc --options ./typedoc.ds.json",
    "test": "node ../../tools/repo-tools/bin/repo-vitest.cjs --coverage --watch=false",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.vitest.json --noEmit",
    "prepublishOnly": "node ../../common/scripts/copy-license.cjs",
    "size": "node ../../tools/repo-tools/bin/size-check.cjs"
  },
  "license": "MIT",
  "author": {
    "name": "Manu Ramirez <@pixerael>",
    "email": "manu@yoltra.dev"
  },
  "maintainers": [],
  "homepage": "https://yoltra.dev",
  "keywords": [
    "design-system",
    "react",
    "tokens",
    "ui",
    "yoltra"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yoltra/yoltra.git"
  },
  "bugs": {
    "url": "https://github.com/yoltra/yoltra/issues"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/types/index.d.ts",
  "private": false,
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.12",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react-swc": "^3.10.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "5.9.3",
    "vite": "^7.1.11",
    "vite-plugin-banner": "0.8.1",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^4.3.2",
    "sass-embedded": "^1.93.2",
    "typedoc": "^0.28.13",
    "typedoc-plugin-markdown": "4.9.0",
    "@testing-library/react": "16.3.0",
    "@vitest/coverage-v8": "3.2.4",
    "jsdom": "^24.0.0",
    "vitest": "3.2.4"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/types/client.d.ts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.cjs",
      "default": "./dist/client.mjs"
    },
    "./package.json": "./package.json",
    "./styles/*": "./dist/styles/*"
  },
  "sizeLimit": [
    {
      "name": "a typical import",
      "import": "{ Button, Card, Stack, Text }",
      "limitKb": 4,
      "external": [
        "react",
        "react-dom",
        "tslib"
      ]
    },
    {
      "name": "barrel",
      "limitKb": 8,
      "external": [
        "react",
        "react-dom",
        "tslib"
      ]
    },
    {
      "name": "a dialog",
      "entry": "dist/client.mjs",
      "import": "{ Dialog }",
      "limitKb": 3,
      "external": [
        "react",
        "react-dom",
        "tslib"
      ]
    },
    {
      "name": "client barrel",
      "entry": "dist/client.mjs",
      "limitKb": 5.5,
      "external": [
        "react",
        "react-dom",
        "tslib"
      ]
    }
  ]
}

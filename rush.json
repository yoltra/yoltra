{
  "$schema": "https://developer.microsoft.com/json-schemas/rush/v5/rush.schema.json",

  /**
   * Increment this after upgrading Rush to a newer version.
   * Verify the latest: `npm view @microsoft/rush version`
   */
  "rushVersion": "5.168.0",

  /**
   * The version of PNPM that Rush will install and use internally.
   * Verify the latest: `npm view pnpm version`
   */
  "pnpmVersion": "9.15.0",

  /**
   * Reject Node.js versions outside this range (enforced on `rush install`).
   */
  "nodeSupportedVersionRange": ">=18.18.0 <25.0.0",

  /**
   * The baseline `rush change` and `rush change --verify` diff against. Without it Rush infers
   * the remote and warns on every invocation, and the branch a change file is judged against is
   * whatever the local checkout happens to imply rather than something the repo states.
   *
   * Also the single source of truth for the URL npm Trusted Publishing matches against:
   * common/scripts/check-publish-metadata.mjs reads it from here rather than carrying its own
   * copy, so the two cannot drift.
   */
  "repository": {
    "url": "https://github.com/yoltra/yoltra.git",
    "defaultBranch": "main",
    "defaultRemote": "origin"
  },

  /**
   * Allow projects to reside up to 3 folders deep (e.g. examples/v0/yoltra-in-react).
   * Rush default is 2. We need 3 for the examples/v0/* structure.
   */
  "projectFolderMinDepth": 1,
  "projectFolderMaxDepth": 3,

  // ---------------------------------------------------------------------------
  // PNPM options live in common/config/rush/pnpm-config.json (that file can
  // also carry globalOverrides, which rush.json's pnpmOptions cannot).
  // ---------------------------------------------------------------------------

  // ---------------------------------------------------------------------------
  // Versioning behaviour
  // ---------------------------------------------------------------------------

  /**
   * Require every publishable package to pin the exact same version for any
   * dependency that appears in multiple projects. Helps avoid version skew.
   */
  "ensureConsistentVersions": true,

  /**
   * Enable hotfix change files only if you have a hotfix branch workflow.
   * Disabled here to keep the flow simple.
   */
  "hotfixChangeEnabled": false,

  // ---------------------------------------------------------------------------
  // Projects
  // (Order does not matter — Rush resolves the dependency graph automatically.)
  // ---------------------------------------------------------------------------
  "projects": [
    // ------------------------------------------------------------------
    // Tooling — ESLint shared configs (published, no lockstep policy)
    // ------------------------------------------------------------------
    {
      "packageName": "@yoltra/eslint-config-base",
      "projectFolder": "tools/eslint-config-base",
      "reviewCategory": "tools",
      "shouldPublish": true
    },
    {
      "packageName": "@yoltra/eslint-config-react",
      "projectFolder": "tools/eslint-config-react",
      "reviewCategory": "tools",
      "shouldPublish": true
    },

    // ------------------------------------------------------------------
    // Core libraries - El mero mero sabor ranchero...
    // ------------------------------------------------------------------
    {
      "packageName": "@yoltra/core",
      "projectFolder": "packages/core",
      "reviewCategory": "production",
      "shouldPublish": true,
      "versionPolicyName": "yoltra"
    },
    {
      "packageName": "@yoltra/react",
      "projectFolder": "packages/react",
      "reviewCategory": "production",
      "shouldPublish": true,
      "versionPolicyName": "yoltra"
    },
    {
      "packageName": "@yoltra/ds",
      "projectFolder": "packages/ds",
      "reviewCategory": "production",
      "shouldPublish": true,
      "versionPolicyName": "ds"
    },

    // ------------------------------------------------------------------
    // Devtools — published
    // ------------------------------------------------------------------
    {
      "packageName": "@yoltra/devtools-protocol",
      "projectFolder": "devtools/devtools-protocol",
      "reviewCategory": "devtools",
      "shouldPublish": true,
      "versionPolicyName": "yoltra"
    },
    {
      "packageName": "@yoltra/devtools-server",
      "projectFolder": "devtools/devtools-server",
      "reviewCategory": "devtools",
      "shouldPublish": true,
      "versionPolicyName": "yoltra"
    },
    {
      "packageName": "@yoltra/devtools-ui",
      "projectFolder": "devtools/devtools-ui",
      "reviewCategory": "devtools",
      "shouldPublish": true,
      "versionPolicyName": "yoltra"
    },
    {
      "packageName": "@yoltra/devtools-storeview",
      "projectFolder": "devtools/devtools-storeview",
      "reviewCategory": "devtools",
      "shouldPublish": true,
      "versionPolicyName": "yoltra"
    },
    {
      "packageName": "@yoltra/devtools-browser-agent",
      "projectFolder": "devtools/devtools-browser-agent",
      "reviewCategory": "devtools",
      "shouldPublish": true,
      "versionPolicyName": "yoltra"
    },
    {
      "packageName": "@yoltra/devtools-node-agent",
      "projectFolder": "devtools/devtools-node-agent",
      "reviewCategory": "devtools",
      "shouldPublish": true,
      "versionPolicyName": "yoltra"
    },
    {
      "packageName": "@yoltra/devtools-ext",
      "projectFolder": "devtools/devtools-ext",
      "reviewCategory": "devtools",
      "shouldPublish": false
    },
    {
      "packageName": "@yoltra/devtools-cli",
      "projectFolder": "devtools/devtools-cli",
      "reviewCategory": "devtools",
      "shouldPublish": true,
      "versionPolicyName": "yoltra"
    },

    // ------------------------------------------------------------------
    // Examples — never published
    // ------------------------------------------------------------------
    {
      "packageName": "yoltra-in-react",
      "projectFolder": "examples/v0/yoltra-in-react",
      "reviewCategory": "samples",
      // Examples consume @yoltra/* from the published npm feed (real versions,
      // not workspace:*) so they work in StackBlitz and a plain `npm install`.
      // decoupledLocalDependencies tells Rush this is intentional.
      "decoupledLocalDependencies": [
        "@yoltra/core",
        "@yoltra/react",
        "@yoltra/ds",
        "@yoltra/devtools-browser-agent"
      ],
      "shouldPublish": false
    },
    {
      "packageName": "yoltra-in-nextjs",
      "projectFolder": "examples/v0/yoltra-in-nextjs",
      "reviewCategory": "samples",
      "decoupledLocalDependencies": [
        "@yoltra/core",
        "@yoltra/react",
        "@yoltra/ds",
        "@yoltra/devtools-browser-agent"
      ],
      "shouldPublish": false
    },
    {
      "packageName": "yoltra-kinetic-logo",
      "projectFolder": "examples/v0/yoltra-kinetic-logo",
      "reviewCategory": "samples",
      "decoupledLocalDependencies": [
        "@yoltra/core",
        "@yoltra/react",
        "@yoltra/ds",
        "@yoltra/devtools-browser-agent"
      ],
      "shouldPublish": false
    },
    {
      "packageName": "yoltra-react-counter",
      "projectFolder": "examples/v0/yoltra-react-counter",
      "reviewCategory": "samples",
      "decoupledLocalDependencies": [
        "@yoltra/core",
        "@yoltra/react",
        "@yoltra/ds"
      ],
      "shouldPublish": false
    },
    {
      "packageName": "yoltra-mission-control",
      "projectFolder": "examples/v0/yoltra-mission-control",
      "reviewCategory": "samples",
      "decoupledLocalDependencies": [
        "@yoltra/core",
        "@yoltra/react",
        "@yoltra/ds",
        "@yoltra/devtools-protocol",
        "@yoltra/devtools-browser-agent",
        "@yoltra/devtools-ui",
        "@yoltra/devtools-storeview"
      ],
      "shouldPublish": false
    },

    {
      "packageName": "@eraelco/repo-tools",
      "projectFolder": "tools/repo-tools",
      "reviewCategory": "tools",
      "shouldPublish": false
    }
  ]
}
